@{
    ViewData["Title"] = "Home";
}

<div class="hero text-center text-white">
    <h1 class="display-5 fw-bold">Event Registration Portal</h1>
    <p class="lead mb-4">Discover events, book your seat, and never miss out.</p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <a asp-controller="Events" asp-action="Index" class="btn btn-light btn-lg">Browse events</a>
    }
    else
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg me-2">Register</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Login</a>
    } 
    
</div>

