@model Event_Registration_Portal.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow border-0 text-center">
            <div class="card-body p-4">
                <h2 class="text-success mb-1">Booking confirmed</h2>
                <p class="text-muted mb-4">Thank you, @Model.User.Name</p>
                <table class="table table-borderless text-start mb-4">
                    <tr><th>Booking ID</th><td>#@Model.Id</td></tr>
                    <tr><th>Event</th><td>@Model.Event.Title</td></tr>
                    <tr><th>Date</th><td>@Model.Event.EventDate.ToString("dd MMM yyyy, HH:mm")</td></tr>
                    <tr><th>Seat number</th><td>@Model.SeatNumber</td></tr>
                    <tr><th>Booked on</th><td>@Model.BookedOn.ToString("dd MMM yyyy, HH:mm")</td></tr>
                </table>
                <a asp-controller="Events" asp-action="Index" class="btn btn-primary">Back to events</a>
            </div>
        </div>
    </div>
</div>